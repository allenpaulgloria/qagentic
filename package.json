    "commander": "^13.1.0",
    "dotenv": "^18.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
